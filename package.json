{
  "name": "apeiron-remake",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "vr:baseline": "node tools/baseline.mjs",
    "vr:gate": "node tools/gate.mjs",
    "vr:capture": "node tools/capture.mjs",
    "vr:profile": "node tools/profile.mjs",
    "vr:playtest": "node tools/playtest.mjs",
    "vr:serve": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sparticles": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "description": "A remake of the Apeiron game using React and Vite with modern web technologies",
  "license": "MIT"
}
